<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Title>Tail - Live text and log viewer</Title>
    <AssemblyTitle>$(Title)</AssemblyTitle>
    <Product>Tail</Product>
    <Authors>Fernando Paz</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Copyright (c) 2026 Fernando Paz</Copyright>
    <Description>Live text and log file viewer for Windows and Linux terminals.</Description>
    <InformationalVersion>$(Version)</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>

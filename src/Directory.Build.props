<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Title>Catl - Visor de texto y logs en vivo</Title>
    <AssemblyTitle>$(Title)</AssemblyTitle>
    <Product>Catl</Product>
    <Authors>Fernando Paz</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Copyright (c) 2026 Fernando Paz</Copyright>
    <Description>Visor de archivos de texto y logs en vivo para terminales Windows y Linux.</Description>
    <InformationalVersion>$(Version)</InformationalVersion>
    <NeutralLanguage>es</NeutralLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
